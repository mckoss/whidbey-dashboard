# Copy to .env (git-ignored) and fill in.

# Your nationalgeographic.com subscriber session cookie.
# Get it from a logged-in browser: DevTools > Application > Cookies >
# https://www.nationalgeographic.com. Copy the WHOLE cookie header value
# (all name=value pairs, semicolon separated), not just one cookie.
NATGEO_COOKIE="cookie1=value1; cookie2=value2"

# Claude API key, used to condense captions.
ANTHROPIC_API_KEY=sk-ant-...
